{
  "1": {
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    },
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Iris-3B"
    }
  },
  "3": {
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "krea2",
      "device": "default"
    },
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load Qwen3VL 4B Text Encoder"
    }
  },
  "simpligen_lora_1": {
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "1",
        0
      ],
      "clip": [
        "3",
        0
      ]
    },
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    }
  },
  "2": {
    "inputs": {
      "shift": 4.0,
      "model": [
        "simpligen_lora_1",
        0
      ]
    },
    "class_type": "ModelSamplingSD3",
    "_meta": {
      "title": "Flow shift 4 (the released checkpoint's value)"
    }
  },
  "4": {
    "inputs": {
      "text": "{{prompt}}",
      "clip": [
        "simpligen_lora_1",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Positive Prompt"
    }
  },
  "5": {
    "inputs": {
      "text": "{{negative_prompt}}",
      "clip": [
        "simpligen_lora_1",
        1
      ]
    },
    "class_type": "CLIPTextEncode",
    "_meta": {
      "title": "Negative Prompt (empty = Iris's trained null prompt; do not zero it out)"
    }
  },
  "6": {
    "inputs": {
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    },
    "class_type": "EmptyLatentImage",
    "_meta": {
      "title": "Empty Latent Image (expanded to full-size RGB by the Iris pack)"
    }
  },
  "7": {
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "res_multistep",
      "scheduler": "simple",
      "denoise": "{{denoise}}",
      "model": [
        "2",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ]
    },
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    }
  },
  "8": {
    "inputs": {
      "vae_name": "pixel_space"
    },
    "class_type": "VAELoader",
    "_meta": {
      "title": "Pixel-space pass-through (Iris has no VAE; nothing is downloaded)"
    }
  },
  "9": {
    "inputs": {
      "samples": [
        "7",
        0
      ],
      "vae": [
        "8",
        0
      ]
    },
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "10": {
    "inputs": {
      "filename_prefix": "iris-3b",
      "images": [
        "9",
        0
      ]
    },
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    }
  }
}
