{
  "unet_loader": {
    "class_type": "UNETLoader",
    "_meta": {
      "title": "Load Diffusion Model"
    },
    "inputs": {
      "unet_name": "{{unet}}",
      "weight_dtype": "default"
    }
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "_meta": {
      "title": "Load CLIP"
    },
    "inputs": {
      "clip_name": "{{clip}}",
      "type": "fibo2",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "_meta": {
      "title": "Load VAE"
    },
    "inputs": {
      "vae_name": "{{vae}}"
    }
  },
  "simpligen_lora_1": {
    "class_type": "Power Lora Loader (rgthree)",
    "_meta": {
      "title": "SimpliGen User LoRAs"
    },
    "inputs": {
      "PowerLoraLoaderHeaderWidget": {
        "type": "PowerLoraLoaderHeaderWidget"
      },
      "➕ Add Lora": "",
      "model": [
        "unet_loader",
        0
      ],
      "clip": [
        "clip_loader",
        0
      ]
    }
  },
  "img1": {
    "class_type": "LoadImage",
    "_meta": {
      "title": "Picture to edit"
    },
    "inputs": {
      "image": "{{ref_image_1}}"
    }
  },
  "enc": {
    "class_type": "TextEncodeFibo2",
    "_meta": {
      "title": "Text Encode Fibo 2.0"
    },
    "inputs": {
      "clip": [
        "simpligen_lora_1",
        1
      ],
      "prompt": "{{prompt}}",
      "negative_prompt": "{{negative_prompt}}",
      "vae": [
        "vae_loader",
        0
      ],
      "images.image_1": [
        "img1",
        0
      ],
      "width": "{{width}}",
      "height": "{{height}}",
      "batch_size": 1
    }
  },
  "sampler": {
    "class_type": "KSampler",
    "_meta": {
      "title": "KSampler"
    },
    "inputs": {
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "simpligen_lora_1",
        0
      ],
      "positive": [
        "enc",
        0
      ],
      "negative": [
        "enc",
        1
      ],
      "latent_image": [
        "enc",
        2
      ]
    }
  },
  "decode": {
    "class_type": "VAEDecode",
    "_meta": {
      "title": "VAE Decode"
    },
    "inputs": {
      "samples": [
        "sampler",
        0
      ],
      "vae": [
        "vae_loader",
        0
      ]
    }
  },
  "save": {
    "class_type": "SaveImage",
    "_meta": {
      "title": "Save Image"
    },
    "inputs": {
      "filename_prefix": "Fibo2-Edit",
      "images": [
        "decode",
        0
      ]
    }
  }
}
